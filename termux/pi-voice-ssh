#!/usr/bin/env bash
set -euo pipefail

set_name=false
if [[ ${1:-} == --set-device-name ]]; then
  set_name=true
  if (( $# > 2 )) || [[ ${2:-} == -* ]]; then
    printf 'Usage: pi-voice-ssh --set-device-name ["Device name"] (standalone; no SSH target or other options)\n' >&2
    exit 2
  fi
  name_supplied=false
  if (( $# == 2 )); then name_supplied=true; device_name=$2; fi
  shift "$#"
fi

if [[ $set_name == false ]] && (( $# == 0 )); then
  printf 'Usage: pi-voice-ssh [--device-dir <absolute-remote-path>] [ssh options] user@target [remote command]\n       pi-voice-ssh --set-device-name ["Device name"] (standalone local setup/rename)\n' >&2
  exit 2
fi

AUDIO_PORT=${PI_VOICE_AUDIO_PORT:-8765}
CONTROL_PORT=${PI_VOICE_CONTROL_PORT:-8766}

# The registry directory lives on the Pi host. Operators point managed wrappers
# at a non-default one explicitly; otherwise the local override doubles as the
# intended remote path, and unset falls back to ~/.cache/pi-voice/devices.
device_dir_override=${PI_VOICE_DEVICE_DIR:-}
args=()
if [[ $set_name == false ]]; then
while (($# > 0)); do
  case $1 in
    --device-dir)
      if (($# < 2)); then
        printf -- '--device-dir requires an absolute remote path\n' >&2
        exit 2
      fi
      device_dir_override=$2
      shift 2
      ;;
    --device-dir=*)
      device_dir_override=${1#--device-dir=}
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
if [[ -n $device_dir_override && $device_dir_override != /* ]]; then
  printf 'pi-voice-ssh device directory must be absolute: %s\n' "$device_dir_override" >&2
  exit 2
fi

# Find the SSH destination while preserving options and any remote command.
target_index=-1
index=0
while (( index < ${#args[@]} )); do
  arg=${args[index]}
  if [[ $arg == -- ]]; then
    ((index += 1)); target_index=$index; break
  fi
  if [[ $arg == --set-device-name ]]; then
    printf -- '--set-device-name must be first and standalone; no SSH options or target\n' >&2
    exit 2
  fi
  if [[ $arg != -* ]]; then target_index=$index; break; fi
  case $arg in
    -b|-c|-D|-E|-e|-F|-I|-i|-J|-L|-l|-m|-O|-o|-P|-p|-Q|-R|-S|-W|-w)
      ((index += 2)) ;;
    *) ((index += 1)) ;;
  esac
done
(( target_index >= 0 && target_index < ${#args[@]} )) || { printf 'Unable to identify SSH target\n' >&2; exit 2; }
target=${args[target_index]}
if [[ $target == --set-device-name ]]; then
  printf -- '--set-device-name must be first and standalone; no SSH options or target\n' >&2
  exit 2
fi
ssh_options=("${args[@]:0:target_index}")
remote_command=("${args[@]:target_index+1}")
fi

runtime_root=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/pi-voice-ssh-${UID:-$(id -u)}
config_root=${XDG_CONFIG_HOME:-$HOME/.config}/pi-voice
config_error() { printf 'Cannot read/write pi-voice device configuration in %s\n' "$config_root" >&2; exit 1; }
mkdir -p "$config_root" && chmod 700 "$config_root" || config_error
device_name_file=$config_root/device-name
device_id_file=$config_root/device-id
validate_device_name() {
  local LC_ALL=C.UTF-8
  local forbidden whitespace invalid=false utf8
  printf -v whitespace '%b' '[[:space:]\u00a0\u2007\u202f\ufeff]'
  printf -v forbidden '%b' '[\x01-\x1f\x7f-\u009f\u061c\u200e\u200f\u2028\u2029\u202a-\u202e\u2066-\u2069]'
  if [[ -z ${device_name//$whitespace/} || ${#device_name} -gt 128 || $device_name == *$forbidden* ]]; then invalid=true; fi
  # Bash can retain invalid byte sequences; require UTF-8 scalar values before
  # JSON registration or terminal output (no overlong encodings or surrogates).
  LC_ALL=C
  utf8=$'^([\x01-\x7f]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee-\xef][\x80-\xbf]{2}|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf]{2}|[\xf1-\xf3][\x80-\xbf]{3}|\xf4[\x80-\x8f][\x80-\xbf]{2})+$'
  if [[ $invalid == true || ! $device_name =~ $utf8 ]]; then
    printf 'Device name must contain 1–128 UTF-8 characters and no control or bidi characters (not whitespace-only)\n' >&2
    return 2
  fi
}
# First launches read the winner; only an explicit setter replaces the name.
# No lock is held while a user thinks at the prompt.
publish_config() {
  local error
  if error=$({
    umask 077
    temp= operation='open publication lock'
    trap 'status=$?; [[ -z $temp ]] || rm -f "$temp"; if (( status != 0 )); then printf "Save operation failed: %s\n" "$operation" >&2; fi' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # Keep the fence inode: unlinking it lets waiters lock different files.
    exec 9>"$config_root/.device.lock" || exit 1
    operation='acquire publication lock (5 seconds; requires flock from util-linux)'
    flock -x -w 5 9 || exit 1
    [[ ${3:-false} == true || ( ! -e $1 && ! -L $1 ) ]] || exit 0
    operation='create private temporary file'
    temp=$(mktemp "$config_root/.device-XXXXXX") || exit 1
    operation='write temporary file'
    printf '%s\n' "$2" >"$temp" || exit 1
    operation='atomic rename'
    mv -f "$temp" "$1" || exit 1
  } 2>&1); then
    return 0
  fi
  printf 'Cannot save %s in device configuration. Check storage/permissions and retry; retain device-id.\n' "${1##*/}" >&2
  # Utility diagnostics may contain paths; never emit terminal control bytes.
  printf '%s\n' "$error" | LC_ALL=C tr -cd '\11\12\40-\176' >&2
  return 1
}
read_device_name() (
  local LC_ALL=C.UTF-8 character invalid=false tty_state bytes=0 displayed= prompt='Device name (1–128 characters): '
  tty_state=$(stty -g <&"$name_tty") || return 1
  trap 'stty "$tty_state" <&"$name_tty"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # Configure before displaying the prompt, including for immediate pasted EOF.
  stty -echo -icanon -isig min 1 time 0 <&"$name_tty" || return 1
  printf '%s\0337' "$prompt" >&"$name_tty"
  device_name=
  # Unlike a line read, an empty-delimiter read exposes NUL rather than silently
  # dropping it. Read bytes so malformed UTF-8 cannot swallow Enter/EOF; keep
  # at most 512 bytes (128 UTF-8 scalars), then validate the complete name.
  while LC_ALL=C IFS= read -r -d '' -n 1 -u "$name_tty" character; do
    case $character in
      $'\n') [[ $invalid == false ]] || return 1; printf '%s' "$device_name"; return ;;
      $'\x03'|$'\x04') return 1 ;;
      '') invalid=true ;;
      $'\x7f'|$'\x08')
        device_name=${device_name%?}
        bytes=$(LC_ALL=C; printf '%s' "${#device_name}") ;;
      *)
        if (( bytes < 512 )); then device_name+=$character; ((bytes += 1))
        else invalid=true
        fi ;;
    esac
    # Render only complete, safe UTF-8 prefixes. Space-only prefixes are safe
    # while typing; the final validator still rejects a blank submitted name.
    if (device_name="x$device_name"; validate_device_name) 2>/dev/null || validate_device_name 2>/dev/null; then
      if [[ $device_name == "$displayed"* ]]; then
        printf '%s' "${device_name:${#displayed}}" >&"$name_tty"
      else
        # Restore the input origin and erase the old suffix, including wide
        # characters/wrapped lines; never calculate terminal cell widths.
        printf '\0338\033[J%s' "$device_name" >&"$name_tty"
      fi
      displayed=$device_name
    fi
  done
  return 1
)
ssh_config=
if [[ $set_name == true && $name_supplied == true ]]; then
  validate_device_name
  publish_config "$device_name_file" "$device_name" true || exit 1
  exit 0
fi
if [[ $set_name == true || ! -e $device_name_file ]]; then
  # Resolve batch intent with SSH itself, including config files and option case.
  # This is the same local config query used below, never a login connection.
  if [[ $set_name == false ]]; then
    ssh_config=$(ssh -G "${ssh_options[@]}" "$target" 2>/dev/null)
  fi
  if [[ $(awk '$1=="batchmode" {print $2; exit}' <<<"$ssh_config") == yes ]] ||
     ! { exec {name_tty}<>/dev/tty; } 2>/dev/null; then
    printf 'Device name needs a controlling terminal (and non-BatchMode for SSH). Use pi-voice-ssh --set-device-name "My device" to provision %s without a terminal.\n' "$device_name_file" >&2
    exit 2
  fi
  # Never consume SSH stdin, or echo unvalidated terminal escape sequences.
  if ! device_name=$(read_device_name); then
    printf '\nDevice name cancelled or invalid; no connection started.\n' >&2
    exit 2
  fi
  printf '\n' >&"$name_tty"
  exec {name_tty}>&-
  validate_device_name
  publish_config "$device_name_file" "$device_name" "$set_name" || exit 1
  [[ $set_name == false ]] || exit 0
fi
# Read at most 1025 bytes (128 UTF-8 characters need at most 512), reject NUL
# explicitly, and permit just one conventional final newline, not extra lines.
[[ -f $device_name_file && -r $device_name_file ]] || config_error
if LC_ALL=C IFS= read -r -d '' -n 1025 device_name <"$device_name_file"; then
  printf 'Invalid device-name file: NUL or excessive length\n' >&2
  exit 2
fi
device_name=${device_name%$'\n'}
validate_device_name
chmod 600 "$device_name_file" || config_error
if [[ ! -e $device_id_file ]]; then
  if command -v uuidgen >/dev/null 2>&1; then new_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
  else new_id=$(</proc/sys/kernel/random/uuid)
  fi
  publish_config "$device_id_file" "$new_id" || exit 1
fi
chmod 600 "$device_id_file" || config_error
device_id=$(tr -cd 'a-zA-Z0-9._-' <"$device_id_file")
[[ -n $device_id ]] || { printf 'Invalid device id in %s\n' "$device_id_file" >&2; exit 1; }
mkdir -p "$runtime_root"
chmod 700 "$runtime_root"
# Controls are rejected above; only backslashes and quotes need JSON escaping.
device_name_json=${device_name//\\/\\\\}
device_name_json=${device_name_json//\"/\\\"}
if [[ ${PREFIX:-} == *com.termux* ]]; then platform=termux; else platform=linux; fi

ssh_config=${ssh_config:-$(ssh -G "${ssh_options[@]}" "$target" 2>/dev/null)}
host=$(awk '$1=="hostname" {print $2; exit}' <<<"$ssh_config")
user=$(awk '$1=="user" {print $2; exit}' <<<"$ssh_config")
port=$(awk '$1=="port" {print $2; exit}' <<<"$ssh_config")
configured_remote_command=$(awk '$1=="remotecommand" {$1=""; sub(/^ /, ""); print; exit}' <<<"$ssh_config")
canonical=${user}@${host}:${port}
target_hash=$(printf '%s' "$canonical" | sha256sum | cut -c1-20)
if [[ ${PI_VOICE_SSH_DRY_RUN:-0} == 1 ]]; then
  printf 'device=%s platform=%s target=%s hash=%s deviceDir=%s\n' "$device_id" "$platform" "$canonical" "$target_hash" "${device_dir_override:-default}"
  exit 0
fi
target_state=$runtime_root/targets/$target_hash
control_socket=$runtime_root/cm-$target_hash.sock
session_file=$target_state/sessions/$$
mkdir -p "$target_state/sessions"

lock_token=$$
lock_owner_alive() {
  local path=$1 owner
  [[ -L $path ]] || return 1
  owner=$(readlink "$path" 2>/dev/null || true)
  [[ $owner =~ ^[0-9]+$ ]] || return 1
  kill -0 "$owner" 2>/dev/null || return 1
  # Avoid treating a recycled pid as the old wrapper when procfs is readable.
  [[ ! -r /proc/$owner/cmdline ]] || grep -aq 'pi-voice-ssh' "/proc/$owner/cmdline" 2>/dev/null
}
legacy_wrapper_alive() {
  local cmdline pid
  shopt -s nullglob
  for cmdline in /proc/[0-9]*/cmdline; do
    pid=${cmdline#/proc/}; pid=${pid%/cmdline}
    if [[ $pid != "$lock_token" ]] && grep -aq 'pi-voice-ssh' "$cmdline" 2>/dev/null; then
      shopt -u nullglob
      return 0
    fi
  done
  shopt -u nullglob
  return 1
}
acquire_path_lock() {
  local path=$1 stale
  while ! ln -s "$lock_token" "$path" 2>/dev/null; do
    if lock_owner_alive "$path"; then
      sleep 0.05
      continue
    fi
    # Old wrappers used ownerless directories. Never steal one while another
    # legacy wrapper could still be in its setup critical section.
    if [[ -d $path && ! -L $path ]] && legacy_wrapper_alive; then
      sleep 0.05
      continue
    fi
    # Rename first so concurrent reclaimers can never delete a newly acquired lock.
    stale=${path}.stale.${lock_token}.${RANDOM}
    if mv "$path" "$stale" 2>/dev/null; then rm -rf "$stale"; fi
  done
}
release_path_lock() {
  local path=$1 owner=
  if [[ -L $path ]]; then owner=$(readlink "$path" 2>/dev/null || true); fi
  if [[ $owner == "$lock_token" ]]; then rm -f "$path"; fi
  return 0
}
lock_dir=$target_state/lock
acquire_lock() { acquire_path_lock "$lock_dir"; }
release_lock() { release_path_lock "$lock_dir"; }
clean_sessions() {
  local file pid
  shopt -s nullglob
  for file in "$target_state"/sessions/*; do
    pid=$(<"$file")
    kill -0 "$pid" 2>/dev/null || rm -f "$file"
  done
  shopt -u nullglob
}
clean_all_sessions() {
  local file pid
  shopt -s nullglob
  for file in "$runtime_root"/targets/*/sessions/*; do
    pid=$(<"$file")
    kill -0 "$pid" 2>/dev/null || rm -f "$file"
  done
  shopt -u nullglob
}

bridge_pid_file=$runtime_root/client-bridge.pid
# A pid file alone cannot be trusted: after a suspend the recorded pid may
# belong to an unrelated process, which previously left playback pointing at a
# dead reverse tunnel (ECONNREFUSED) until the client restarted manually.
probe_audio_port() {
  # hello is a control-only request: even pre-v2 handlers ignore it safely.
  # A TCP accept alone says nothing about protocol support.
  local response
  if command -v socat >/dev/null 2>&1; then
    response=$(printf 'PI_VOICE_CONTROLhello\n' |
      socat -T1 - "TCP:127.0.0.1:${AUDIO_PORT}" 2>/dev/null) || return 1
  elif command -v node >/dev/null 2>&1; then
    response=$(node -e '
      const c=require("net").createConnection({host:"127.0.0.1",port:Number(process.argv[1])});
      let response="";
      c.on("connect",()=>c.end("PI_VOICE_CONTROLhello\n"));
      c.on("data",b=>{response+=b;if(response.length>1024)process.exit(1)});
      c.on("end",()=>{process.stdout.write(response);process.exit(0)});
      c.on("error",()=>process.exit(1));setTimeout(()=>process.exit(1),1000);
    ' "$AUDIO_PORT") || return 1
  else
    return 1
  fi
  [[ $response == '{"type":"protocol","version":2}' ]]
}

bridge_alive() {
  local pid=$1
  if [[ -z $pid ]]; then
    return 1
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  if [[ -r /proc/$pid/cmdline ]] && grep -aq "pi-voice-client" /proc/$pid/cmdline 2>/dev/null; then
    return 0
  fi
  # No /proc or unexpected cmdline: fall back to probing the audio port.
  probe_audio_port
}

ensure_bridge() {
  local bridge_lock=$runtime_root/bridge.lock pid=
  acquire_path_lock "$bridge_lock"
  [[ -s $bridge_pid_file ]] && pid=$(<"$bridge_pid_file")
  if ! bridge_alive "$pid"; then
    rm -f "$bridge_pid_file"
    local bridge=${PI_VOICE_CLIENT_COMMAND:-$HOME/.local/bin/pi-voice-client}
    if [[ ! -x $bridge ]]; then
      release_path_lock "$bridge_lock"
      printf 'Missing %s; install the pi-voice client scripts first\n' "$bridge" >&2
      exit 1
    fi
    # Leftover listeners or players from a previous bridge can steal ports or
    # hold a dead audio FIFO, producing silent playback after reconnects.
    pkill -f "pi-voice-audio-session" 2>/dev/null || true
    pkill -f "pi-voice-stt-session" 2>/dev/null || true
    pkill -f "TCP4-LISTEN:${AUDIO_PORT}" 2>/dev/null || true
    pkill -f "TCP4-LISTEN:${CONTROL_PORT}" 2>/dev/null || true
    sleep 0.15
    "$bridge" >"$runtime_root/client-bridge.log" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" >"$bridge_pid_file"
    # Wait for a v2 capability ACK, not merely an open listener.
    local tick=0
    while (( tick < 20 )); do
      if probe_audio_port; then break; fi
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
      (( tick += 1 )) || true
    done
    if ! kill -0 "$pid" 2>/dev/null || ! probe_audio_port; then
      release_path_lock "$bridge_lock"
      printf 'Audio bridge did not acknowledge protocol v2; legacy, malformed, or unavailable endpoint (update client scripts).\n' >&2
      cat "$runtime_root/client-bridge.log" >&2
      exit 1
    fi
    release_path_lock "$bridge_lock"
  else
    release_path_lock "$bridge_lock"
  fi
}

shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

remote_home=
remote_device_dir=
remote_audio_port_file=$target_state/audio-port
remote_input_port_file=$target_state/input-port
remote_registration=

allocate_remote_port() {
  local label=$1 local_port=$2 allocation port
  if ! allocation=$(ssh -S "$control_socket" -O forward \
    -R "127.0.0.1:0:127.0.0.1:${local_port}" "$target" 2>&1); then
    printf 'Unable to allocate remote %s forwarding port: %s\n' "$label" "$allocation" >&2
    return 1
  fi
  port=$(awk '
    $1 ~ /^[0-9]+$/ { print $1; exit }
    tolower($1) == "allocated" && tolower($2) == "port" && $3 ~ /^[0-9]+$/ { print $3; exit }
  ' <<<"$allocation")
  if [[ ! $port =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
    printf 'SSH did not report a valid remote %s forwarding port: %s\n' "$label" "$allocation" >&2
    return 1
  fi
  printf '%s\n' "$port"
}

# Roll back a newly created master if setup fails before registration completes.
# Never close an existing master: another wrapper may still be using it.
created_master=false
setup_cleanup() {
  if [[ $created_master == true ]]; then
    ssh -S "$control_socket" -O exit "$target" >/dev/null 2>&1 || true
    rm -f "$control_socket" "$remote_audio_port_file" "$remote_input_port_file"
  fi
  release_lock
  acquire_path_lock "$runtime_root/bridge.lock"
  clean_all_sessions
  local sessions
  shopt -s nullglob
  sessions=("$runtime_root"/targets/*/sessions/*)
  shopt -u nullglob
  if (( ${#sessions[@]} == 0 )) && [[ -s $bridge_pid_file ]]; then
    local pid
    pid=$(<"$bridge_pid_file")
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    rm -f "$bridge_pid_file"
  fi
  release_path_lock "$runtime_root/bridge.lock"
}
trap setup_cleanup EXIT
acquire_lock
clean_sessions
ensure_bridge
if ! ssh -S "$control_socket" -O check "$target" >/dev/null 2>&1; then
  rm -f "$control_socket" "$remote_audio_port_file" "$remote_input_port_file"
  ssh "${ssh_options[@]}" -o RemoteCommand=none -o ControlMaster=yes -o ControlPersist=no \
    -S "$control_socket" -N -f "$target"
  created_master=true
fi
remote_home=$(ssh "${ssh_options[@]}" -S "$control_socket" -o RemoteCommand=none "$target" 'printf %s "$HOME"')
remote_device_dir=${device_dir_override:-$remote_home/.cache/pi-voice/devices}
remote_registration=$remote_device_dir/$device_id.json
ssh "${ssh_options[@]}" -S "$control_socket" -o RemoteCommand=none "$target" \
  "mkdir -p $(shell_quote "$remote_device_dir") && chmod 700 $(shell_quote "$remote_device_dir")" >/dev/null
if [[ ! -s $remote_audio_port_file ]]; then
  allocate_remote_port audio "$AUDIO_PORT" >"$remote_audio_port_file"
fi
if [[ ! -s $remote_input_port_file ]]; then
  allocate_remote_port microphone "$CONTROL_PORT" >"$remote_input_port_file"
fi
remote_audio_port=$(<"$remote_audio_port_file")
remote_input_port=$(<"$remote_input_port_file")
now=$(date +%s000)
printf -v registration '{"version":1,"id":"%s","name":"%s","platform":"%s","audioEndpoint":"tcp://127.0.0.1:%s","inputEndpoint":"tcp://127.0.0.1:%s","connectedAt":%s,"lastActive":%s}\n' \
  "$device_id" "$device_name_json" "$platform" "$remote_audio_port" "$remote_input_port" "$now" "$now"
printf '%s' "$registration" | ssh "${ssh_options[@]}" -S "$control_socket" -o RemoteCommand=none "$target" \
  "umask 077; cat >$(shell_quote "$remote_registration")"
printf '%s\n' "$$" >"$session_file"
release_lock

cleanup() {
  trap - EXIT INT TERM
  acquire_lock
  rm -f "$session_file"
  clean_sessions
  shopt -s nullglob
  target_sessions=("$target_state"/sessions/*)
  shopt -u nullglob
  if (( ${#target_sessions[@]} == 0 )); then
    ssh "${ssh_options[@]}" -S "$control_socket" -o RemoteCommand=none "$target" \
      "rm -f $(shell_quote "$remote_registration")" >/dev/null 2>&1 || true
    ssh -S "$control_socket" -O exit "$target" >/dev/null 2>&1 || true
    rm -rf "$target_state" "$control_socket"
  fi
  release_lock

  # The client bridge is shared by every target and closes with the final shell.
  bridge_lock=$runtime_root/bridge.lock
  acquire_path_lock "$bridge_lock"
  clean_all_sessions
  shopt -s nullglob
  all_sessions=("$runtime_root"/targets/*/sessions/*)
  shopt -u nullglob
  if (( ${#all_sessions[@]} == 0 )) && [[ -s $bridge_pid_file ]]; then
    bridge_pid=$(<"$bridge_pid_file")
    kill "$bridge_pid" 2>/dev/null || true
    wait "$bridge_pid" 2>/dev/null || true
    rm -f "$bridge_pid_file"
  fi
  release_path_lock "$bridge_lock"
}
trap cleanup EXIT INT TERM

# Registration confirms identity, not audio readiness.
printf 'Connected to %s\n' "$device_name" >&2
export PI_VOICE_DEVICE_ID=$device_id
export PI_VOICE_DEVICE_TARGET=$target_hash
remote_env="PI_VOICE_DEVICE_ID=$(shell_quote "$device_id") PI_VOICE_DEVICE_TARGET=$(shell_quote "$target_hash")"
if [[ -n $device_dir_override ]]; then
  remote_env+=" PI_VOICE_DEVICE_DIR=$(shell_quote "$device_dir_override")"
fi
if (( ${#remote_command[@]} > 0 )); then
  quoted_command=
  for word in "${remote_command[@]}"; do quoted_command+="$(shell_quote "$word") "; done
  ssh "${ssh_options[@]}" -S "$control_socket" -o RemoteCommand=none -t "$target" \
    "env $remote_env $quoted_command"
elif [[ -n $configured_remote_command && $configured_remote_command != none ]]; then
  ssh "${ssh_options[@]}" -S "$control_socket" -o "RemoteCommand=env $remote_env $configured_remote_command" "$target"
else
  ssh "${ssh_options[@]}" -S "$control_socket" -o RemoteCommand=none -t "$target" \
    "env $remote_env \"\${SHELL:-/bin/sh}\" -l"
fi
