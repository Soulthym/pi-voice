#!/usr/bin/env bash
set -u

runtime_dir="${TMPDIR:-/data/data/com.termux/files/usr/tmp}"
umask 077
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
valid_boot() { [[ $1 =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; }
valid_boot "$boot_id" || exit 1
# Legacy runtime ownership has no boot/dispatch proof. Never migrate it as idle.
for legacy in pi-voice-recording-active pi-voice-recording-lock pi-voice-recording-pending \
  pi-voice-stop-recording pi-voice-recording-lock.tickets pi-voice-recording-lock.fence; do
  [[ ! -e $runtime_dir/$legacy && ! -L $runtime_dir/$legacy ]] || exit 1
done
state_home=${XDG_STATE_HOME:-${HOME:?}/.local/state}
state_dir="$state_home/pi-voice/microphone/termux"
durable_parent=$state_home
while [[ ! -d $durable_parent ]]; do durable_parent=$(dirname "$durable_parent"); done
mkdir -p -m 700 "$state_dir" || exit 1
for directory in "$state_home/pi-voice" "$state_home/pi-voice/microphone" "$state_dir"; do
  [[ ! -L $directory && -O $directory && $(stat -c %a "$directory") == 700 ]] || exit 1
done
directory=$state_dir
while :; do
  sync "$directory" || exit 1
  [[ $directory -ef $durable_parent ]] && break
  directory=$(dirname "$directory")
done
stop_file="$state_dir/stop"
active_file="$state_dir/active"
recording_lock="$state_dir/recording"
pending_file="$state_dir/pending"
completed_file="$state_dir/start-completed"
quit_file="$state_dir/quit-uncertain"

encode_message() {
  printf '%s' "$1" | base64 | tr -d '\n'
}

# Epoch and both counters are replaced together under the persistent fence.
ticket_state="$recording_lock.tickets"
valid_counter() {
  [[ $1 =~ ^(0|[1-9][0-9]{0,15})$ ]] && (( $1 <= 9007199254740991 ))
}
load_tickets() {
  epoch= latest=0 watermark=0 saved_boot=$boot_id dispatch=-
  if [[ -e $ticket_state ]]; then
    IFS=' ' read -r epoch latest watermark saved_boot dispatch extra <"$ticket_state" || exit 1
    [[ $epoch =~ ^[0-9a-f]{32}$ ]] && valid_counter "$latest" && valid_counter "$watermark" && [[ -z $extra ]] && valid_boot "$saved_boot" && (( watermark <= latest )) || exit 1
    [[ $dispatch == - || $dispatch =~ ^[0-9a-f]{32}\.[1-9][0-9]{0,15}:[1-9][0-9]*$ ]] || exit 1
    if [[ $saved_boot != "$boot_id" ]]; then
      # Kernel reboot closes old dispatches; same-boot idle snapshots do not.
      watermark=$latest
      rm -f "$active_file" "$stop_file" "$pending_file" "$completed_file" "$quit_file" || exit 1
      rmdir "$recording_lock" 2>/dev/null || true
      saved_boot=$boot_id dispatch=-
      save_tickets
    fi
  elif [[ -e $active_file || -e $pending_file || -e $recording_lock ]]; then
    exit 1
  fi
  if [[ -e $active_file ]]; then
    owner=$(cat "$active_file") || exit 1
    [[ $owner == "$dispatch" && $dispatch != - ]] || exit 1
  elif [[ $dispatch != - ]]; then
    # Missing ownership evidence cannot prove a surviving Android capture idle.
    exit 1
  fi
}
save_tickets() {
  printf '%s %s %s %s %s\n' "$epoch" "$latest" "$watermark" "$saved_boot" "$dispatch" >"$ticket_state.tmp" &&
    sync "$ticket_state.tmp" && mv -f "$ticket_state.tmp" "$ticket_state" && sync "$state_dir" || exit 1
}

retire_dispatch() {
  load_tickets
  dispatch=-
  save_tickets
  rm -f "$active_file" "$stop_file" "$pending_file"
  rmdir "$recording_lock" 2>/dev/null || true
}
confirmed_quit() {
  # A timed-out quit may execute against the next capture. Never retry past it.
  [[ ! -e $quit_file ]] || return 1
  : >"$quit_file" && sync "$quit_file" "$state_dir" || return 1
  timeout 2s termux-microphone-record -q 9>&- >/dev/null 2>&1 || return 1
  rm -f "$quit_file" && sync "$state_dir"
}

# Never unlink this fence: admission, cancellation and start share its inode.
exec 9>"$recording_lock.fence"
IFS= read -r command || exit 1
flock -x 9 || exit 1
load_tickets
issued_ticket=
if [[ $command == ticket ]]; then
  if [[ -z $epoch ]]; then
    epoch=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    [[ $epoch =~ ^[0-9a-f]{32}$ ]] || exit 1
  fi
  if (( latest == 9007199254740991 )); then
    printf 'error %s\n' "$(encode_message 'Microphone ticket space exhausted')"
    exit 0
  fi
  (( latest += 1 ))
  save_tickets
  issued_ticket="$epoch.$latest"
  flock -u 9
  printf 'ticket %s %s\n' "$issued_ticket" "$boot_id"
  IFS= read -r command || exit 1
  [[ $command == "record $issued_ticket $boot_id" && $(cat /proc/sys/kernel/random/boot_id 2>/dev/null) == "$boot_id" ]] || exit 1
  flock -x 9 || exit 1
  load_tickets
fi
if [[ $command == stop\ * && -z $issued_ticket ]]; then
  ticket=${command#stop }
  counter=${ticket#*.}
  if [[ $ticket != "$epoch.$counter" || -z $epoch ]] || ! valid_counter "$counter" || (( counter == 0 || counter > latest )); then
    printf 'error %s\n' "$(encode_message 'Invalid microphone ticket')"
    exit 0
  fi
  (( counter > watermark )) && watermark=$counter
  save_tickets
  owner=$(cat "$active_file" 2>/dev/null || true)
  [[ ${owner%%:*} == "$ticket" ]] || owner=
  if [[ -n $owner ]]; then
    : >"$stop_file"
    if [[ -e $pending_file ]]; then
      # Cancel admission even when its dependency/device check is still blocked.
      retire_dispatch
    elif ! kill -0 "${owner##*:}" 2>/dev/null; then
      # A dead API client does not imply a stopped Android MediaRecorder.
      # Hold the admission fence through confirmation and stale-lease retirement.
      if confirmed_quit && [[ $(cat "$completed_file" 2>/dev/null || true) == "$owner" ]] &&
        timeout 2s termux-microphone-record -i 9>&- 2>/dev/null | grep -Eq '"isRecording"[[:space:]]*:[[:space:]]*false'; then
        retire_dispatch
      else
        printf 'error %s\n' "$(encode_message 'Microphone stop not confirmed')"
        exit 0
      fi
    fi
  fi
  sync "$state_dir" || exit 1
  flock -u 9
  for _ in {1..90}; do
    [[ -z $owner || $(cat "$active_file" 2>/dev/null || true) != "$owner" ]] && break
    sleep 0.1
  done
  if [[ -z $owner || $(cat "$active_file" 2>/dev/null || true) != "$owner" ]]; then
    flock -x 9 || exit 1
    load_tickets
    [[ ${dispatch%%:*} != "$ticket" ]] || exit 1
    sync "$state_dir" || exit 1
    printf 'ok %s\n' "$(encode_message "stopped $ticket")"
  else
    printf 'error %s\n' "$(encode_message 'Microphone stop not confirmed')"
  fi
  exit 0
fi
if [[ -z $issued_ticket ]]; then
  printf 'error %s\n' "$(encode_message "Unsupported phone voice command: $command")"
  exit 0
fi
[[ $issued_ticket == "$epoch.$latest" ]] && (( latest > watermark )) || exit 1
# A crash between mkdir and marker publication cannot have dispatched a start.
[[ -e $active_file ]] || rmdir "$recording_lock" 2>/dev/null || true
if [[ -e $active_file ]] || ! mkdir "$recording_lock" 2>/dev/null; then
  printf 'error %s\n' "$(encode_message 'The phone microphone is already recording')"
  exit 0
fi
recording_owner="$issued_ticket:$BASHPID"
dispatch=$recording_owner
save_tickets
recording="$runtime_dir/pi-voice-recording-${recording_owner}.ogg"
rm -f "$recording" "$stop_file" "$completed_file"
printf '%s\n' "$recording_owner" >"$active_file.tmp" && sync "$active_file.tmp" &&
  mv -f "$active_file.tmp" "$active_file" && sync "$state_dir" || exit 1
: >"$pending_file" || exit 1
sync "$active_file" "$pending_file" "$state_dir" || exit 1
recorder_stopped=true
starter_pid=
tail_pid=
disconnect_pid=
stop_recorder() {
  [[ $recorder_stopped == true ]] && return 0
  [[ $(cat "$active_file" 2>/dev/null || true) == "$recording_owner" ]] || return 1
  confirmed_quit || return 1
  # Caller exit plus idle is not dispatch closure. Require positive completion.
  if [[ $(cat "$completed_file" 2>/dev/null || true) == "$recording_owner" ]] &&
    timeout 2s termux-microphone-record -i 9>&- 2>/dev/null | grep -Eq '"isRecording"[[:space:]]*:[[:space:]]*false'; then
    recorder_stopped=true
    return 0
  fi
  return 1
}
cleanup() {
  trap - EXIT
  trap '' INT TERM HUP
  [[ -n $starter_pid ]] && wait "$starter_pid" 2>/dev/null || true
  flock -x 9
  stop_recorder || true
  [[ -n $tail_pid ]] && kill "$tail_pid" 2>/dev/null || true
  [[ -n $disconnect_pid ]] && kill "$disconnect_pid" 2>/dev/null || true
  if [[ $recorder_stopped == true && $(cat "$active_file" 2>/dev/null || true) == "$recording_owner" ]]; then
    retire_dispatch
  fi
  sync "$state_dir" || exit 1
  flock -u 9
  rm -f "$recording"
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP
flock -u 9
exec 3<&0
( exec 9>"$recording_lock.fence"
  while IFS= read -r _ <&3; do :; done
  flock -x 9
  [[ $(cat "$active_file" 2>/dev/null || true) == "$recording_owner" ]] && : >"$stop_file"
) &
disconnect_pid=$!

# Admission is visible before any potentially blocking dependency/device check.
if ! command -v termux-microphone-record >/dev/null 2>&1; then
  printf 'error %s\n' "$(encode_message 'termux-microphone-record is unavailable; install the Termux:API app and run pkg install termux-api')"
  exit 0
fi
max_record_seconds=${PI_VOICE_MAX_RECORD_SECONDS:-120}
flock -x 9
[[ $(cat "$active_file" 2>/dev/null || true) == "$recording_owner" && ! -e $stop_file ]] || exit 1
recorder_stopped=false
rm -f "$pending_file" || exit 1
sync "$state_dir" || exit 1
printf 'stream\n'
# The API callback can fail even when Android successfully starts recording.
(
  # Unknown response formats fail closed. A successful stock API response is
  # distinct from a timed-out or interrupted caller, even if info says idle.
  if response=$(timeout 2s termux-microphone-record -f "$recording" -l "$max_record_seconds" \
    -e opus -r 16000 -c 1 9>&- 2>/dev/null) &&
    [[ ( ${response%%$'\n'*} == "Recording started: $recording" ||
         ${response%%$'\n'*} == "Recording started: $recording " ) &&
       ${response#*$'\n'} =~ ^Max\ Duration:\ ([0-9]+(:[0-9]+)*|unlimited)$ ]]; then
    printf '%s\n' "$recording_owner" >"$completed_file.tmp" &&
      sync "$completed_file.tmp" && mv -f "$completed_file.tmp" "$completed_file" && sync "$state_dir"
  fi
) 9>&- &
starter_pid=$!
flock -u 9

for _ in {1..100}; do
  [[ -s "$recording" || -e $stop_file ]] && break
  sleep 0.05
done
if [[ ! -s "$recording" ]]; then
  wait "$starter_pid" 2>/dev/null || true
  exit 1
fi
# Termux:API rejects FIFO output paths.
tail -c +1 -f -s 0.05 "$recording" 9>&- &
tail_pid=$!
for (( tick = 0; tick < max_record_seconds * 10; tick++ )); do
  [[ -e "$stop_file" ]] && break
  kill -0 "$tail_pid" 2>/dev/null || break
  sleep 0.1
done
wait "$starter_pid" 2>/dev/null || true
stop_recorder || exit 1

# Forward the final Ogg page after confirmed stop.
previous_size=-1
stable=0
for _ in {1..40}; do
  current_size=$(stat -c %s "$recording" 2>/dev/null || printf 0)
  if [[ "$current_size" == "$previous_size" ]]; then
    (( stable += 1 ))
  else
    stable=0
    previous_size=$current_size
  fi
  (( stable >= 3 )) && break
  sleep 0.1
done
sleep 0.15
kill "$tail_pid" 2>/dev/null || true
wait "$tail_pid" 2>/dev/null || true
