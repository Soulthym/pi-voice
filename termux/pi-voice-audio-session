#!/usr/bin/env bash
set -u

runtime_dir=${TMPDIR:-/data/data/com.termux/files/usr/tmp}
# Secure per-stream identity, never a reusable process identifier.
random=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
[[ $random =~ ^[0-9a-f]{32}$ ]] || exit 1
printf -v variant '%x' "$(( (16#${random:16:1} & 3) | 8 ))"
session_id="${random:0:8}-${random:8:4}-4${random:13:3}-$variant${random:17:3}-${random:20:12}"
ipc_socket="$runtime_dir/pi-voice-mpv-$session_id.sock"
header_file="$runtime_dir/pi-voice-header-$session_id.bin"
audio_fifo="$runtime_dir/pi-voice-mpv-$session_id.pcm"
player_lock="$runtime_dir/pi-voice-player.lock"
active_player_file="$runtime_dir/pi-voice-active-player.pid"
mpv_pid=
player_exited=false
feeder_pid=
lock_held=false
protocol=1
state_home=${XDG_STATE_HOME:-${HOME:?}/.local/state}
playback_dir="$state_home/pi-voice/playback"
state_dir="$playback_dir/$session_id"
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
if [[ $boot_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
  boot_id="\"$boot_id\""
else
  boot_id=null
fi

publish_exit() (
  umask 077
  printf '{"id":"%s","boot_id":%s}\n' "$session_id" "$boot_id" >"$state_dir/exited.tmp" &&
    sync "$state_dir/exited.tmp" &&
    mv -f "$state_dir/exited.tmp" "$state_dir/exited" &&
    sync "$state_dir"
)

cleanup() {
  trap - EXIT
  trap '' INT TERM
  [[ -n "$feeder_pid" ]] && kill "$feeder_pid" 2>/dev/null || true
  [[ $player_exited == false && -n "$mpv_pid" ]] && kill "$mpv_pid" 2>/dev/null || true
  [[ -n "$feeder_pid" ]] && wait "$feeder_pid" 2>/dev/null || true
  if [[ $player_exited == false && -n "$mpv_pid" ]]; then
    wait "$mpv_pid" 2>/dev/null || true
    player_exited=true
  fi
  # Retain own-child wait proof even after the normal path clears its PID.
  [[ $player_exited == true ]] && publish_exit
  if [[ -n "$mpv_pid" ]] && [[ $(cat "$active_player_file" 2>/dev/null || true) == "$session_id $mpv_pid" ]]; then
    rm -f "$active_player_file"
  fi
  [[ $lock_held == true ]] && rm -rf "$player_lock" 2>/dev/null || true
  rm -f "$ipc_socket" "$audio_fifo" "$header_file"
}
trap cleanup EXIT
trap 'exit 1' INT TERM
# Losing the feedback connection must not truncate buffered playback.
trap '' PIPE HUP

# A short control connection can pause, resume, or stop a specific existing
# player without framing or modifying the raw Float32 audio stream.
exec 3<&0
dd iflag=fullblock bs=16 count=1 of="$header_file" status=none <&3 2>/dev/null || true
# An empty connection is not a new stream and must not replace a player.
[[ -s $header_file ]] || exit 0
if cmp -s "$header_file" <(printf 'PI_VOICE_CONTROL'); then
  command=
  target_id=
  IFS=' ' read -r command target_id <&3 || true
  if [[ $command == hello && -z $target_id ]]; then
    protocol=3
    printf '{"type":"protocol","version":3}\n' || exit 1
    audio_header=
    IFS= read -r -n 128 audio_header <&3 || exit 1
    [[ $audio_header == PI_VOICE_PREPARE && $boot_id != null ]] || exit 1
  else
    [[ $target_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || exit 0
    target_socket="$runtime_dir/pi-voice-mpv-$target_id.sock"
    target_state="$playback_dir/$target_id"
    legacy_state="$runtime_dir/pi-voice-session-$target_id"
    if [[ $command == pause || $command == resume ]] && [[ -S $target_socket ]]; then
      paused=false
      [[ $command == pause ]] && paused=true
      printf '{"command":["set_property","pause",%s]}\n' "$paused" |
        socat -T 1 - "UNIX-CONNECT:$target_socket" >/dev/null 2>&1 || true
    elif [[ $command == stop ]]; then
      # The same scope lock covers commit/spawn and stop's durable tombstone.
      if [[ -d $target_state && -f $target_state/prepared ]]; then
        exec 9>"$target_state/lock" || exit 1
        flock -x -w 5 9 || exit 1
        (umask 077; touch "$target_state/stopped") && sync "$target_state/stopped" "$target_state" || exit 1
        if [[ ! -f $target_state/committed ]]; then
          session_id=$target_id state_dir=$target_state boot_id="$(cat "$target_state/prepared")" publish_exit || exit 1
        fi
        flock -u 9
      else
        for target in "$target_state" "$legacy_state"; do
          [[ -d $target ]] && (umask 077; touch "$target/stopped")
        done
      fi
      if [[ -S $target_socket ]]; then
        printf '{"command":["quit"]}\n' |
          socat -T 1 - "UNIX-CONNECT:$target_socket" >/dev/null 2>&1 || true
      fi
      # A missing socket/PID is not proof of exit. Retain the owner's receipt
      # for retries when a stop ACK (or natural completion) was lost.
      for _ in {1..100}; do
        if { [[ -f $target_state/exited ]] && sync "$target_state/exited" "$target_state"; } || [[ -f $legacy_state/exited ]]; then
          if [[ -f $target_state/exited ]]; then
            receipt=$(cat "$target_state/exited")
            printf '{"type":"stopped",%s\n' "${receipt:1}" || true
          else
            printf '{"type":"stopped","id":"%s"}\n' "$target_id" || true
          fi
          break
        fi
        [[ -d $target_state || -d $legacy_state ]] || break
        sleep 0.05
      done
    fi
    exit 0
  fi
fi

# Raw PCM and v2 clients may not start physical output.
[[ $protocol == 3 ]] || exit 1

# Reserve a durable opaque scope before any player I/O.
(
  umask 077
  durable_parent=$state_home
  while [[ ! -d $durable_parent ]]; do durable_parent=$(dirname "$durable_parent"); done
  mkdir -p "$state_home" || exit 1
  for directory in "$state_home/pi-voice" "$playback_dir"; do
    [[ ! -L $directory ]] || exit 1
    mkdir -p "$directory" && [[ -O $directory ]] && chmod 700 "$directory" || exit 1
  done
  mkdir -m 700 "$state_dir" || exit 1
  printf '%s\n' "$boot_id" >"$state_dir/prepared" || exit 1
  sync "$state_dir/prepared" || exit 1
  directory=$state_dir
  while :; do
    sync "$directory" || exit 1
    [[ $directory -ef $durable_parent ]] && break
    directory=$(dirname "$directory")
  done
) || exit 1
printf '{"type":"prepared","version":3,"id":"%s","boot_id":%s}\n' "$session_id" "$boot_id" || exit 1
commit=
IFS= read -r -n 128 commit <&3 || exit 1
[[ $commit == "PI_VOICE_COMMIT $session_id ${boot_id//\"/}" ]] || exit 1
exec 9>"$state_dir/lock" || exit 1
flock -x -w 5 9 || exit 1
[[ ! -f $state_dir/stopped ]] || exit 1
# Persist possible dispatch BEFORE spawn; a crash here remains conservatively fenced.
(umask 077; touch "$state_dir/committed") && sync "$state_dir/committed" "$state_dir" || exit 1

# Starting a new stream atomically replaces any prior Pi Voice player. This is
# an endpoint-level safety net for rapid seeks and cross-session preemption.
for _ in {1..100}; do
  if mkdir "$player_lock" 2>/dev/null; then
    lock_held=true
    printf '%s\n' "${BASHPID:-$$}" >"$player_lock/owner"
    break
  fi
  lock_owner=$(cat "$player_lock/owner" 2>/dev/null || true)
  lock_command=$(tr '\0' ' ' <"/proc/$lock_owner/cmdline" 2>/dev/null || true)
  if [[ -z $lock_owner ]]; then
    sleep 0.05
    [[ -z $(cat "$player_lock/owner" 2>/dev/null || true) ]] && rm -rf "$player_lock" 2>/dev/null || true
  elif [[ ! $lock_owner =~ ^[0-9]+$ ]] || [[ $lock_command != *pi-voice-audio-session* ]]; then
    rm -rf "$player_lock" 2>/dev/null || true
  fi
  sleep 0.01
done
[[ $lock_held == true ]] || exit 1
old_id= old_player=
read -r old_id old_player <"$active_player_file" 2>/dev/null || true
old_player_command=$(tr '\0' ' ' <"/proc/$old_player/cmdline" 2>/dev/null || true)
if [[ $old_player =~ ^[0-9]+$ ]] && [[ $old_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] && [[ $old_player_command == *"--input-ipc-server=$runtime_dir/pi-voice-mpv-$old_id.sock "* ]] && kill -0 "$old_player" 2>/dev/null; then
  kill "$old_player" 2>/dev/null || true
  for _ in {1..50}; do
    kill -0 "$old_player" 2>/dev/null || break
    sleep 0.01
  done
  kill -0 "$old_player" 2>/dev/null && kill -KILL "$old_player" 2>/dev/null || true
fi

# ponytail: retain receipts indefinitely; add expiry only with a safe retry horizon.
rm -f "$ipc_socket" "$audio_fifo"
mkfifo "$audio_fifo"

mpv --really-quiet --no-video --cache=no \
  --input-ipc-server="$ipc_socket" \
  --demuxer=rawaudio \
  --demuxer-rawaudio-format=floatle \
  --demuxer-rawaudio-rate=24000 \
  --demuxer-rawaudio-channels=mono \
  "$audio_fifo" 9>&- > /dev/null 2>/dev/null &
mpv_pid=$!
flock -u 9
exec 9>&-
printf '%s %s\n' "$session_id" "$mpv_pid" >"$active_player_file"
rm -rf "$player_lock" 2>/dev/null || true
lock_held=false

# stdin is the TCP audio direction. stdout is deliberately kept free for JSON
# playback-position feedback over the reverse direction of the same socket.
cat <&3 >"$audio_fifo" &
feeder_pid=$!

for _ in {1..50}; do
  [[ -S "$ipc_socket" ]] && break
  kill -0 "$mpv_pid" 2>/dev/null || exit 1
  sleep 0.02
done
[[ -S "$ipc_socket" ]] || exit 1
[[ ! -f $state_dir/stopped ]] || exit 0
printf '{"type":"session","version":3,"id":"%s","boot_id":%s}\n' "$session_id" "$boot_id" || true

request_id=0
while kill -0 "$mpv_pid" 2>/dev/null; do
  ((request_id += 1))
  response=$(
    printf '{"command":["get_property","time-pos"],"request_id":%d}\n' "$request_id" |
      socat -T 0.08 - "UNIX-CONNECT:$ipc_socket" 2>/dev/null || true
  )
  position=${response#*\"data\":}
  position=${position%%,*}
  if [[ "$position" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    printf '{"type":"playback","position":%s}\n' "$position" || true
  fi
  sleep 0.08
done

if kill -0 "$feeder_pid" 2>/dev/null; then
  kill "$feeder_pid" 2>/dev/null || true
fi
feeder_status=0
wait "$feeder_pid" 2>/dev/null || feeder_status=$?
feeder_pid=
player_status=0
# The polling loop has ended; do not interrupt reaping/proof publication.
trap '' INT TERM
wait "$mpv_pid" 2>/dev/null || player_status=$?
player_exited=true
trap 'exit 1' INT TERM
if [[ $(cat "$active_player_file" 2>/dev/null || true) == "$session_id $mpv_pid" ]]; then
  rm -f "$active_player_file"
fi
mpv_pid=
publish_exit || exit 1
if [[ $protocol == 3 && $player_status == 0 && $feeder_status == 0 && ! -f $state_dir/stopped ]]; then
  printf '{"type":"complete","id":"%s","boot_id":%s}\n' "$session_id" "$boot_id" || true
fi
