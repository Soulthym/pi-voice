#!/usr/bin/env bash
set -u

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ ${PREFIX:-} == *com.termux* ]] || command -v termux-microphone-record >/dev/null 2>&1; then
  exec "$SCRIPT_DIR/pi-voice-termux-stt-session"
fi

runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
state_dir="$runtime_dir/pi-voice-client-${UID:-$(id -u)}"
stop_file="$state_dir/stop-recording"
active_file="$state_dir/recording-active"
recording_lock="$state_dir/recording-lock"
pending_file="$state_dir/recording-pending"
mkdir -p "$state_dir"

encode_message() {
  printf '%s' "$1" | base64 | tr -d '\n'
}

# Epoch and both counters are replaced together under the persistent fence.
ticket_state="$recording_lock.tickets"
valid_counter() {
  [[ $1 =~ ^(0|[1-9][0-9]{0,15})$ ]] && (( $1 <= 9007199254740991 ))
}
load_tickets() {
  epoch= latest=0 watermark=0
  if [[ -e $ticket_state ]]; then
    IFS=' ' read -r epoch latest watermark extra <"$ticket_state" || exit 1
    [[ $epoch =~ ^[0-9a-f]{32}$ ]] && valid_counter "$latest" && valid_counter "$watermark" && [[ -z $extra ]] && (( watermark <= latest )) || exit 1
  fi
}
save_tickets() {
  printf '%s %s %s\n' "$epoch" "$latest" "$watermark" >"$ticket_state.tmp" &&
    mv -f "$ticket_state.tmp" "$ticket_state" || exit 1
}

# Never unlink this fence: admission, cancellation and start share its inode.
exec 9>"$recording_lock.fence"
IFS= read -r command || exit 1
flock -x 9 || exit 1
load_tickets
issued_ticket=
if [[ $command == ticket ]]; then
  if [[ -z $epoch ]]; then
    epoch=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    [[ $epoch =~ ^[0-9a-f]{32}$ ]] || exit 1
  fi
  if (( latest == 9007199254740991 )); then
    printf 'error %s\n' "$(encode_message 'Microphone ticket space exhausted')"
    exit 0
  fi
  (( latest += 1 ))
  save_tickets
  issued_ticket="$epoch.$latest"
  flock -u 9
  printf 'ticket %s\n' "$issued_ticket"
  IFS= read -r command || exit 1
  [[ $command == "record $issued_ticket" ]] || exit 1
  flock -x 9 || exit 1
  load_tickets
fi
if [[ $command == stop\ * && -z $issued_ticket ]]; then
  ticket=${command#stop }
  counter=${ticket#*.}
  if [[ $ticket != "$epoch.$counter" || -z $epoch ]] || ! valid_counter "$counter" || (( counter == 0 || counter > latest )); then
    printf 'error %s\n' "$(encode_message 'Invalid microphone ticket')"
    exit 0
  fi
  (( counter > watermark )) && watermark=$counter
  save_tickets
  owner=$(cat "$active_file" 2>/dev/null || true)
  [[ ${owner%%:*} == "$ticket" ]] || owner=
  if [[ -n $owner ]]; then
    : >"$stop_file"
    if [[ -e $pending_file ]]; then
      # A blocked device check can finish, but cannot start this generation.
      rm -f "$active_file" "$stop_file" "$pending_file"
      rmdir "$recording_lock" 2>/dev/null || true
    fi
  fi
  flock -u 9
  for _ in {1..90}; do
    [[ -z $owner || $(cat "$active_file" 2>/dev/null || true) != "$owner" ]] && break
    sleep 0.1
  done
  if [[ -z $owner || $(cat "$active_file" 2>/dev/null || true) != "$owner" ]]; then
    printf 'ok %s\n' "$(encode_message "stopped $ticket")"
  else
    printf 'error %s\n' "$(encode_message 'Microphone stop not confirmed')"
  fi
  exit 0
fi
if [[ -z $issued_ticket ]]; then
  printf 'error %s\n' "$(encode_message "Unsupported local voice command: $command")"
  exit 0
fi
[[ $issued_ticket == "$epoch.$latest" ]] && (( latest > watermark )) || exit 1
# A crash between mkdir and marker publication leaves only an empty directory.
[[ -e $active_file ]] || rmdir "$recording_lock" 2>/dev/null || true
if [[ -e $active_file ]] || ! mkdir "$recording_lock" 2>/dev/null; then
  printf 'error %s\n' "$(encode_message 'The local microphone is already recording')"
  exit 0
fi
recording_owner="$issued_ticket:${BASHPID:-$$}"
rm -f "$stop_file"
printf '%s\n' "$recording_owner" >"$active_file" || exit 1
: >"$pending_file" || exit 1
producer_pid=
disconnect_pid=
cleanup() {
  trap - EXIT INT TERM
  [[ -n ${disconnect_pid:-} ]] && kill "$disconnect_pid" 2>/dev/null || true
  [[ -n ${producer_pid:-} ]] && kill -- "-$producer_pid" 2>/dev/null || true
  [[ -n ${producer_pid:-} ]] && wait "$producer_pid" 2>/dev/null || true
  flock -x 9
  if [[ $(cat "$active_file" 2>/dev/null || true) == "$recording_owner" ]]; then
    rm -f "$active_file" "$stop_file" "$pending_file"
    rmdir "$recording_lock" 2>/dev/null || true
  fi
  flock -u 9
}
trap cleanup EXIT
trap 'exit 1' INT TERM
flock -u 9
# EOF means the capture client disconnected. Only stop this recording generation.
exec 3<&0
( exec 9>"$recording_lock.fence"
  while IFS= read -r _ <&3; do :; done
  flock -x 9
  [[ $(cat "$active_file" 2>/dev/null || true) == "$recording_owner" ]] && : >"$stop_file"
) &
disconnect_pid=$!

# Publish admission before any potentially blocking dependency/device check.
if ! command -v ffmpeg >/dev/null 2>&1; then
  printf 'error %s\n' "$(encode_message 'ffmpeg is required for local microphone capture')"
  exit 0
fi
pulse_source=
command -v pactl >/dev/null 2>&1 && pulse_source=$(pactl get-default-source 2>/dev/null || true)
if command -v pw-record >/dev/null 2>&1 && command -v wpctl >/dev/null 2>&1 && wpctl get-volume @DEFAULT_AUDIO_SOURCE@ >/dev/null 2>&1 && { [[ -z $pulse_source ]] || [[ $pulse_source != *.monitor ]]; }; then
  recorder=pw-record
elif command -v parec >/dev/null 2>&1 && { [[ -z $pulse_source ]] || [[ $pulse_source != *.monitor ]]; }; then
  recorder=parec
else
  printf 'error %s\n' "$(encode_message 'No usable default Linux microphone found; connect one and install PipeWire or PulseAudio utilities')"
  exit 0
fi
max_record_seconds=${PI_VOICE_MAX_RECORD_SECONDS:-120}
flock -x 9
[[ $(cat "$active_file" 2>/dev/null || true) == "$recording_owner" && ! -e $stop_file ]] || exit 1
rm -f "$pending_file"
printf 'stream\n'
if [[ $recorder == pw-record ]]; then
  setsid bash -c '
    trap "wait; exit" TERM
    # pw-record uses raw PCM for stdout ("-"); --raw is a parec-only option.
    pw-record --format s16 --rate 16000 --channels 1 - 2>/dev/null |
      ffmpeg -hide_banner -loglevel error -f s16le -ar 16000 -ac 1 -i pipe:0 \
        -c:a libopus -application voip -b:a 32k -vbr on -f ogg pipe:1 2>/dev/null
  ' 9>&- &
else
  setsid bash -c '
    trap "wait; exit" TERM
    parec --raw --format=s16le --rate=16000 --channels=1 2>/dev/null |
      ffmpeg -hide_banner -loglevel error -f s16le -ar 16000 -ac 1 -i pipe:0 \
        -c:a libopus -application voip -b:a 32k -vbr on -f ogg pipe:1 2>/dev/null
  ' 9>&- &
fi
producer_pid=$!
flock -u 9

for ((tick = 0; tick < max_record_seconds * 10; tick += 1)); do
  [[ -e $stop_file ]] && break
  kill -0 "$producer_pid" 2>/dev/null || break
  sleep 0.1
done
kill -TERM -- "-$producer_pid" 2>/dev/null || true
wait "$producer_pid" 2>/dev/null || true
producer_pid=
