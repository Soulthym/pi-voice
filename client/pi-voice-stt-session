#!/usr/bin/env bash
set -u
umask 077

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ ${PREFIX:-} == *com.termux* ]] || command -v termux-microphone-record >/dev/null 2>&1; then
  exec "$SCRIPT_DIR/pi-voice-termux-stt-session"
fi

encode_message() { printf '%s' "$1" | base64 | tr -d '\n'; }
fail() { printf 'error %s\n' "$(encode_message "$1")"; exit 1; }
valid_boot() { [[ $1 =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; }
actual_boot() {
  boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) && valid_boot "$boot_id" || fail 'Kernel boot identity unavailable'
}
valid_counter() { [[ $1 =~ ^(0|[1-9][0-9]{0,15})$ ]] && (( $1 <= 9007199254740991 )); }
random_id() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }
actual_boot
runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
legacy_dir="$runtime_dir/pi-voice-client-${UID:-$(id -u)}"
state_home=${XDG_STATE_HOME:-${HOME:?}/.local/state}
state_dir="$state_home/pi-voice/microphone-desktop"
ticket_state="$state_dir/tickets"
stop_file="$state_dir/stop-recording"
# Publish new directory entries only through the first existing parent.
durable_parent=$(dirname "$state_dir")
while [[ ! -d $durable_parent ]]; do durable_parent=$(dirname "$durable_parent"); done
# Runtime witness detects loss of durable state while this boot may still own work.
# Total loss of both stores is indistinguishable from first install; old epochs
# still fail closed, and host input accounting remains uncertain.
for directory in "$state_home/pi-voice" "$legacy_dir"; do
  [[ ! -L $directory ]] || fail 'Unsafe microphone state directory'
  mkdir -p "$directory" && [[ -O $directory ]] && chmod 700 "$directory" || exit 1
done
exec 8>"$legacy_dir/desktop-durable.fence" || exit 1
flock -x 8 || exit 1
new_state=false
if [[ ! -e $state_dir ]]; then
  for evidence in "$legacy_dir"/recording-* "$legacy_dir/stop-recording" "$legacy_dir/desktop-durable"; do
    [[ ! -e $evidence && ! -L $evidence ]] || fail 'Legacy or lost microphone state requires explicit recovery'
  done
  mkdir -m 700 "$state_dir" || exit 1
  new_state=true
fi
[[ -d $state_dir && ! -L $state_dir && -O $state_dir ]] && chmod 700 "$state_dir" || exit 1
[[ ! -L $state_dir/fence && ! -L $ticket_state && ! -L $ticket_state.tmp && ! -L $legacy_dir/desktop-durable ]] || exit 1
# Never unlink this fence: all durable transitions share its inode.
exec 9>"$state_dir/fence" || exit 1
flock -x 9 || exit 1
save_tickets() {
  printf '%s %s %s %s %s %s %s\n' "$state_boot" "$epoch" "$latest" "$watermark" "$active" "$incarnation" "$phase" >"$ticket_state.tmp" &&
    sync "$ticket_state.tmp" && mv -f "$ticket_state.tmp" "$ticket_state" && sync "$state_dir" || exit 1
}
load_tickets() {
  local extra
  [[ -f $ticket_state && $(wc -l <"$ticket_state") == 1 ]] || fail 'Microphone state lost or invalid'
  IFS=' ' read -r state_boot epoch latest watermark active incarnation phase extra <"$ticket_state" || fail 'Microphone state lost or invalid'
  valid_boot "$state_boot" && [[ $epoch =~ ^[0-9a-f]{32}$ ]] && valid_counter "$latest" && valid_counter "$watermark" &&
    valid_counter "$active" && (( watermark <= latest && active <= latest )) && [[ -z $extra ]] || fail 'Microphone state invalid'
  if (( active == 0 )); then
    [[ $incarnation == - && $phase == idle ]] || fail 'Microphone state invalid'
  else
    [[ $incarnation =~ ^[0-9a-f]{32}$ && ( $phase == pending || $phase == admitted ) ]] || fail 'Microphone state invalid'
  fi
  actual_boot
  if [[ $state_boot != "$boot_id" ]]; then
    # Only a verified different kernel boot retires an orphan, never PID absence.
    state_boot=$boot_id watermark=$latest active=0 incarnation=- phase=idle
    save_tickets
  fi
}
if [[ $new_state == true ]]; then
  state_boot=$boot_id epoch=$(random_id) latest=0 watermark=0 active=0 incarnation=- phase=idle
  [[ $epoch =~ ^[0-9a-f]{32}$ ]] || exit 1
  save_tickets
  directory=$state_dir
  while :; do
    sync "$directory" || exit 1
    [[ $directory -ef $durable_parent ]] && break
    directory=$(dirname "$directory")
  done
fi
# Retry must also publish ancestors left behind by an interrupted initialization.
# syncfs covers those entries even when they now look like existing parents.
sync -f "$state_dir" || exit 1
load_tickets
printf '%s\n' "$epoch" >"$legacy_dir/desktop-durable" && sync "$legacy_dir/desktop-durable" "$legacy_dir" || exit 1
flock -u 8
exec 8>&-
flock -u 9
IFS= read -r command || exit 1
flock -x 9 || exit 1
load_tickets
# A receipt names both directly owned PID incarnations, never shared idle state.
# Legacy ticket/stop remains a separate protocol.
scope_identity() {
  local scope=$1 ticket=$2 boot=$3 incarnation recorder encoder
  incarnation=$(cat "$scope/admitted") && [[ $incarnation =~ ^[0-9a-f]{32}$ ]] || return 1
  recorder=$(cat "$scope/recorder") && [[ $recorder =~ ^[1-9][0-9]*\ [0-9]+$ ]] || return 1
  encoder=$(cat "$scope/encoder") && [[ $encoder =~ ^[1-9][0-9]*\ [0-9]+$ ]] || return 1
  printf 'wait-v1 %s %s %s\n%s\n%s\n' "$ticket" "$boot" "$incarnation" "$recorder" "$encoder"
}
issued_ticket=
wait_scope=
if [[ $command == ticket || $command == ticket-wait || $command == ticket-admit ]]; then
  wait_protocol=false
  [[ $command != ticket ]] && wait_protocol=true
  (( latest < 9007199254740991 )) || fail 'Microphone ticket space exhausted'
  (( latest += 1 ))
  save_tickets
  issued_ticket="$epoch.$latest"
  issued_boot=$boot_id
  if [[ $wait_protocol == true ]]; then
    # ponytail: retain scopes indefinitely; expiry needs a safe host retry horizon.
    wait_scope="$state_dir/scope-$issued_ticket"
    mkdir -m 700 "$wait_scope" || exit 1
    printf '%s pending\n' "$issued_boot" >"$wait_scope/prepared" &&
      sync "$wait_scope/prepared" "$wait_scope" "$state_dir" || exit 1
  fi
  flock -u 9
  if [[ $wait_protocol == true ]]; then
    printf 'ticket %s %s wait-v1\n' "$issued_ticket" "$issued_boot"
  else
    printf 'ticket %s %s\n' "$issued_ticket" "$issued_boot"
  fi
  IFS= read -r command || exit 1
  [[ $command == "record $issued_ticket $issued_boot" ]] || exit 1
  flock -x 9 || exit 1
  load_tickets
  [[ $issued_boot == "$boot_id" ]] || fail 'Microphone boot changed'
fi
if [[ ( $command == stop\ * || $command == stop-wait\ * ) && -z $issued_ticket ]]; then
  stop_boot=
  if [[ $command == stop-wait\ * ]]; then
    read -r _ ticket stop_boot extra <<<"$command"
    valid_boot "$stop_boot" && [[ -z ${extra:-} ]] || fail 'Invalid microphone wait scope'
  else
    ticket=${command#stop }
  fi
  counter=${ticket#*.}
  [[ $ticket == "$epoch.$counter" ]] && valid_counter "$counter" && (( counter > 0 && counter <= latest )) || fail 'Invalid microphone ticket'
  if [[ -n $stop_boot ]]; then
    wait_scope="$state_dir/scope-$ticket"
    [[ -d $wait_scope && ! -L $wait_scope ]] || fail 'Microphone wait scope unavailable'
    scope_state=$(cat "$wait_scope/prepared" 2>/dev/null) || fail 'Microphone wait scope unavailable'
    [[ $scope_state == "$stop_boot pending" || $scope_state == "$stop_boot admitted" ]] || fail 'Microphone wait scope unavailable'
  fi
  (( counter > watermark )) && watermark=$counter
  if (( active == counter )) && [[ $phase == pending ]]; then
    active=0 incarnation=- phase=idle
  fi
  save_tickets
  if [[ -n $stop_boot ]]; then
    # The ticket fence closes delayed record dispatch before non-admission proof.
    touch "$wait_scope/stopped" && sync "$wait_scope/stopped" "$wait_scope" || exit 1
  fi
  if (( active == counter )); then : >"$stop_file" || exit 1; fi
  flock -u 9
  for _ in {1..90}; do
    flock -x 9 || exit 1
    load_tickets
    if [[ -n $stop_boot && -f $wait_scope/admitted && -f $wait_scope/exited && $stop_boot == "$boot_id" ]] && (( active == counter )); then
      expected=$(scope_identity "$wait_scope" "$ticket" "$stop_boot") || fail 'Microphone child identity unavailable'
      if [[ $(cat "$wait_scope/exited") == "$expected" && $(cat "$wait_scope/admitted") == "$incarnation" ]]; then
        sync "$wait_scope/exited" "$wait_scope" || exit 1
        active=0 incarnation=- phase=idle
        save_tickets
      fi
    fi
    if (( active != counter )); then
      # Durable state proves non-admission or owner-published retirement.
      sync "$ticket_state" "$state_dir" || exit 1
      if [[ -n $stop_boot ]]; then
        if [[ $scope_state == "$stop_boot admitted" && $stop_boot == "$boot_id" ]]; then
          # Shared ticket retirement or PID disappearance is NOT a scoped wait.
          expected=$(scope_identity "$wait_scope" "$ticket" "$stop_boot") || fail 'Microphone child identity unavailable'
          [[ $(cat "$wait_scope/exited" 2>/dev/null) == "$expected" ]] || fail 'Microphone child wait receipt unavailable'
          sync "$wait_scope/exited" "$wait_scope" || exit 1
        fi
        printf 'ok %s\n' "$(encode_message "stopped-wait $ticket $stop_boot")"
      else
        printf 'ok %s\n' "$(encode_message "stopped $ticket")"
      fi
      exit 0
    fi
    flock -u 9
    sleep 0.1
  done
  fail 'Microphone stop not confirmed'
fi
[[ -n $issued_ticket ]] || fail "Unsupported local voice command: $command"
[[ $issued_ticket == "$epoch.$latest" ]] && (( latest > watermark )) || exit 1
(( active == 0 )) || fail 'The local microphone has an unresolved recording'
recording_incarnation=$(random_id)
[[ $recording_incarnation =~ ^[0-9a-f]{32}$ ]] || exit 1
recording_counter=$latest
active=$recording_counter incarnation=$recording_incarnation phase=pending
rm -f "$stop_file"
save_tickets
recorder_pid=
encoder_pid=
audio_fifo="$state_dir/pcm-$recording_incarnation"
disconnect_pid=
cleanup() {
  trap - EXIT
  trap '' INT TERM HUP
  exec 4>&- 5<&- 6>&-
  [[ -n ${disconnect_pid:-} ]] && kill "$disconnect_pid" 2>/dev/null || true
  [[ -n ${disconnect_pid:-} ]] && wait "$disconnect_pid" 2>/dev/null || true
  [[ -n ${recorder_pid:-} ]] && kill "$recorder_pid" 2>/dev/null || true
  # Own the recorder directly: waiting a pipeline shell cannot prove that its
  # recorder exited if that shell was killed. Never infer exit from kill -0.
  [[ -n ${recorder_pid:-} ]] && wait "$recorder_pid" 2>/dev/null || true
  # Recorder EOF lets the encoder flush its final packets before retirement.
  [[ -n ${encoder_pid:-} ]] && wait "$encoder_pid" 2>/dev/null || true
  rm -f "$audio_fifo"
  if [[ -n $wait_scope && -n $recorder_pid && -n $encoder_pid ]]; then
    # Only this parent, after both explicit waits, may publish retirement.
    scope_identity "$wait_scope" "$issued_ticket" "$issued_boot" >"$wait_scope/exited.tmp" &&
      sync "$wait_scope/exited.tmp" && mv "$wait_scope/exited.tmp" "$wait_scope/exited" &&
      sync "$wait_scope" || exit 1
  fi
  flock -x 9 || exit 1
  load_tickets
  if [[ $incarnation == "$recording_incarnation" ]]; then
    active=0 incarnation=- phase=idle
    save_tickets
    rm -f "$stop_file"
  fi
  flock -u 9
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP
flock -u 9
exec 3<&0
( exec 9>"$state_dir/fence"
  while IFS= read -r _ <&3; do :; done
  flock -x 9 || exit 1
  load_tickets
  [[ $incarnation == "$recording_incarnation" ]] && : >"$stop_file"
) &
disconnect_pid=$!

# Publish admission before any potentially blocking dependency/device check.
if ! command -v ffmpeg >/dev/null 2>&1; then
  fail 'ffmpeg is required for local microphone capture'
fi
pulse_source=
command -v pactl >/dev/null 2>&1 && pulse_source=$(pactl get-default-source 2>/dev/null || true)
if command -v pw-record >/dev/null 2>&1 && command -v wpctl >/dev/null 2>&1 && wpctl get-volume @DEFAULT_AUDIO_SOURCE@ >/dev/null 2>&1 && { [[ -z $pulse_source ]] || [[ $pulse_source != *.monitor ]]; }; then
  recorder=pw-record
elif command -v parec >/dev/null 2>&1 && { [[ -z $pulse_source ]] || [[ $pulse_source != *.monitor ]]; }; then
  recorder=parec
else
  fail 'No usable default Linux microphone found; connect one and install PipeWire or PulseAudio utilities'
fi
pw_raw=()
if [[ $recorder == pw-record ]]; then
  if ! pw_help=$(timeout -k 1 2 bash -o pipefail -c 'pw-record --help 2>&1 | head -c 65537' 9>&-) || (( ${#pw_help} > 65536 )); then
    fail 'Could not inspect pw-record raw PCM support (help failed or exceeded limits)'
  fi
  [[ $pw_help =~ (^|[[:space:]])--raw([[:space:]=,]|$) ]] && pw_raw=(--raw)
fi
max_record_seconds=${PI_VOICE_MAX_RECORD_SECONDS:-120}
flock -x 9 || exit 1
load_tickets
[[ $incarnation == "$recording_incarnation" && $issued_boot == "$boot_id" && ! -e $stop_file ]] && (( recording_counter > watermark )) || exit 1
mkfifo "$audio_fifo" || exit 1
# Bootstrap both ends before spawning: an early recorder death must not leave
# the encoder blocked opening its reader. No child retains an unused writer.
exec 4<>"$audio_fifo" || exit 1
exec 5<"$audio_fifo" 6>"$audio_fifo" || exit 1
exec 4>&-
phase=admitted
# Crash anywhere after this write remains fenced until the owner waits or reboot.
save_tickets
if [[ -n $wait_scope ]]; then
  printf '%s\n' "$recording_incarnation" >"$wait_scope/admitted" &&
    sync "$wait_scope/admitted" "$wait_scope" || exit 1
  printf '%s admitted\n' "$issued_boot" >"$wait_scope/prepared.tmp" &&
    sync "$wait_scope/prepared.tmp" && mv "$wait_scope/prepared.tmp" "$wait_scope/prepared" &&
    sync "$wait_scope" || exit 1
fi
# Persist the wrapper's kernel incarnation before exec opens the device.
# exec preserves PID/start time; the guardian waits this child, not a pipeline.
scoped_child() {
  local role=$1 stat
  shift
  if [[ -n $wait_scope ]]; then
    local -a fields
    IFS= read -r stat <"/proc/$BASHPID/stat" || exit 1
    read -r -a fields <<<"${stat##*) }"
    [[ ${fields[19]:-} =~ ^[0-9]+$ ]] || exit 1
    printf '%s %s\n' "$BASHPID" "${fields[19]}" >"$wait_scope/$role" &&
      sync "$wait_scope/$role" "$wait_scope" || exit 1
  fi
  exec "$@"
}
printf 'stream\n'
# Defer signals across spawn/PID publication rather than losing an owned child.
trap 'interrupted=true' INT TERM HUP
interrupted=false
if [[ $recorder == pw-record ]]; then
  scoped_child recorder pw-record "${pw_raw[@]}" --format s16 --rate 16000 --channels 1 - >&6 5<&- 6>&- 3<&- 9>&- 2>/dev/null &
else
  scoped_child recorder parec --raw --format=s16le --rate=16000 --channels=1 >&6 5<&- 6>&- 3<&- 9>&- 2>/dev/null &
fi
recorder_pid=$!
scoped_child encoder ffmpeg -hide_banner -loglevel error -f s16le -ar 16000 -ac 1 -i pipe:0 \
  -c:a libopus -application voip -b:a 32k -vbr on -f ogg pipe:1 <&5 5<&- 6>&- 3<&- 9>&- 2>/dev/null &
encoder_pid=$!
exec 5<&- 6>&-
trap 'exit 1' INT TERM HUP
flock -u 9
[[ $interrupted == false ]] || exit 1
for ((tick = 0; tick < max_record_seconds * 10; tick += 1)); do
  [[ -e $stop_file ]] && break
  kill -0 "$encoder_pid" 2>/dev/null || break
  sleep 0.1
done
# EXIT cleanup performs the uninterruptible owned-child wait and durable retirement.
