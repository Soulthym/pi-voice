#!/usr/bin/env bash
set -u
# Job-spec signals below require Bash's per-child (not process-group) path.
set +m

runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
# Secure per-stream identity, never a reusable process identifier.
random=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
[[ $random =~ ^[0-9a-f]{32}$ ]] || exit 1
printf -v variant '%x' "$(( (16#${random:16:1} & 3) | 8 ))"
session_id="${random:0:8}-${random:8:4}-4${random:13:3}-$variant${random:17:3}-${random:20:12}"
ipc_socket="$runtime_dir/pi-voice-mpv-$session_id.sock"
header_file="$runtime_dir/pi-voice-header-$session_id.bin"
audio_fifo="$runtime_dir/pi-voice-mpv-$session_id.pcm"
player_lock="$runtime_dir/pi-voice-player.lock"
active_player_file="$runtime_dir/pi-voice-active-player.pid"
mpv_pid=
player_exited=false
feeder_pid=
lock_held=false
protocol=1
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
native_pid=
native_child=false
renew_ack=
state_home=${XDG_STATE_HOME:-${HOME:?}/.local/state}
playback_dir="$state_home/pi-voice/playback"
state_dir="$playback_dir/$session_id"
kernel_boot() {
  local value
  value=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
  if [[ $value =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    printf '"%s"' "$value"
  else
    printf null
  fi
}
boot_id=$(kernel_boot)
stable_device_id() {
  local value= LC_ALL=C
  # Read only the persisted identity; reject NULs and all but an optional final newline.
  if IFS= read -r -d '' value 2>/dev/null <"${XDG_CONFIG_HOME:-$HOME/.config}/pi-voice/device-id"; then
    printf null
    return
  fi
  value=${value%$'\n'}
  if [[ $value =~ ^[a-zA-Z0-9._-]{1,128}$ ]]; then
    printf '"%s"' "$value"
  else
    printf null
  fi
}
device_id=$(stable_device_id)

# A missing link on modern kernels is not evidence of unsupported time namespaces.
reader_timens() {
  local release major minor names value
  release=$(cat /proc/sys/kernel/osrelease) || return 1
  [[ $release =~ ^([0-9]+)\.([0-9]+)\. ]] || return 1
  major=${BASH_REMATCH[1]} minor=${BASH_REMATCH[2]}
  if (( major < 5 || (major == 5 && minor < 6) )); then
    names=$(LC_ALL=C QUOTING_STYLE=literal ls -1 -- /proc/self/ns) || return 1
    [[ $'\n'$names$'\n' == *$'\npid\n'* && $'\n'$names$'\n' == *$'\nmnt\n'* ]] || return 1
    if [[ $'\n'$names$'\n' != *$'\ntime\n'* ]]; then
      printf 'unsupported-pre5.6'
      return
    fi
  fi
  value=$(readlink /proc/self/ns/time) || return 1
  [[ $value =~ ^time:\[[0-9]+\]$ ]] || return 1
  printf '%s' "$value"
}

# Only a successfully read, unrestricted procfs in the original namespaces can
# establish absence. A failed stat/read/permission check is never absence.
native_gone() {
  local directory=$1 identity bid bboot pid ticks uid pidns mntns version timens extra mounts listing stat tail current_ticks
  [[ -f $directory/bound && -f $directory/committed ]] || return 1
  identity=$(cat "$directory/bound") || return 1
  read -r bid bboot pid ticks uid pidns mntns version timens extra <<<"$identity"
  [[ -z $extra && $bid == "${directory##*/}" && $bboot == "${boot_id//\"/}" && $boot_id != null ]] || return 1
  [[ $pid =~ ^[1-9][0-9]*$ && $ticks =~ ^[0-9]+$ && $uid =~ ^[0-9]+$ && $pidns =~ ^pid:\[[0-9]+\]$ && $mntns =~ ^mnt:\[[0-9]+\]$ ]] || return 1
  [[ $(kernel_boot) == "$boot_id" && $(id -u) == "$uid" ]] || return 1
  [[ $(readlink /proc/self/ns/pid) == "$pidns" && $(readlink /proc/self/ns/mnt) == "$mntns" ]] || return 1
  [[ $version == binding-v2 && -n $timens && $(reader_timens) == "$timens" ]] || return 1
  mounts=$(cat /proc/mounts) || return 1
  local source mount type options rest visible=false
  while read -r source mount type options rest; do
    if [[ $mount == /proc ]]; then
      [[ $type == proc ]] || return 1
      [[ ,$options, != *,hidepid=* || ,$options, == *,hidepid=0,* ]] || return 1
      visible=true
    fi
  done <<<"$mounts"
  [[ $visible == true && -r /proc/self/stat && -x /proc ]] || return 1
  listing=$(LC_ALL=C QUOTING_STYLE=literal ls -1 -- /proc) || return 1
  if [[ $'\n'$listing$'\n' != *$'\n'"$pid"$'\n'* ]]; then
    return 0
  fi
  stat=$(cat "/proc/$pid/stat") || return 1
  [[ $stat == "$pid ("* && $stat == *") "* ]] || return 1
  tail=${stat##*) }
  read -r -a fields <<<"$tail"
  current_ticks=${fields[19]:-}
  [[ $current_ticks =~ ^[0-9]+$ && $current_ticks != "$ticks" ]]
}

publish_native_exit() (
  local directory=$1
  if [[ $directory == "$state_dir" && $native_child == true && $player_exited == true ]]; then
    [[ $boot_id != null && $(kernel_boot) == "$boot_id" && $(reader_timens) == "$bound_timens" ]] || exit 1
  else
    native_gone "$directory" || exit 1
  fi
  umask 077
  printf '{"id":"%s","boot_id":%s,"proof":"native-process-exit"}\n' "${directory##*/}" "$boot_id" >"$directory/exited.tmp" &&
    sync "$directory/exited.tmp" && mv -f "$directory/exited.tmp" "$directory/exited" && sync "$directory"
)

publish_exit() (
  # Waiting for a launcher is not waiting for its native player; never promote
  # an unbound scope. Historical receipts remain readable by the stop path.
  [[ -f $state_dir/bound ]] || exit 1
  exec 8>"$state_dir/lock" && flock -x -w 5 8 && publish_native_exit "$state_dir"
)

# Named, single-process jobs: Bash kill_pid blocks SIGCHLD and skips reaped
# children (PALIVE). Numeric $! signals bypass that check. Do not enable job
# control, use pipelines here, or replace these builtin job-spec signals.
pi_voice_feeder() { exec cat; }
stop_feeder() { builtin kill -KILL %pi_voice_feeder 2>/dev/null || true; }

cleanup() {
  trap - EXIT
  trap '' INT TERM
  [[ -z $renew_ack ]] || rm -f "$renew_ack"
  flock -u 9 2>/dev/null || true
  stop_feeder
  if [[ $player_exited == false && -S $ipc_socket ]]; then
    printf '{"command":["quit"]}\n' | socat -T 0.1 - "UNIX-CONNECT:$ipc_socket" >/dev/null 2>&1 || true
  fi
  if [[ $player_exited == false && -n "$mpv_pid" ]]; then
    # An unsupported idle player or a launcher has no verified native timer.
    # Never wait indefinitely for it to honor TERM; a detached native player
    # remains governed by its scoped IPC/watchdog, not the launcher's job.
    local signal=KILL
    [[ $native_child == true ]] && signal=TERM
    builtin kill -"$signal" %pi_voice_player 2>/dev/null || true
  fi
  [[ -n "$feeder_pid" ]] && wait "$feeder_pid" 2>/dev/null || true
  if [[ $player_exited == false && -n "$mpv_pid" ]]; then
    wait "$mpv_pid" 2>/dev/null || true
    player_exited=true
  fi
  # Retain bound native-child wait proof after the normal path clears its PID.
  [[ $player_exited == true ]] && publish_exit
  if [[ -n "$mpv_pid" ]] && [[ $(cat "$active_player_file" 2>/dev/null || true) == "$session_id ${native_pid:-$mpv_pid}" ]]; then
    rm -f "$active_player_file"
  fi
  [[ $lock_held == true ]] && rm -rf "$player_lock" 2>/dev/null || true
  [[ $player_exited == true ]] && rm -f "$state_dir/binding.ack" "$state_dir/binding.ack.tmp"
  rm -f "$ipc_socket" "$audio_fifo" "$header_file"
}
trap cleanup EXIT
trap 'exit 1' INT TERM
# Losing the feedback connection must not truncate buffered playback.
trap '' PIPE HUP

# A short control connection can pause, resume, or stop a specific existing
# player without framing or modifying the raw Float32 audio stream.
exec 3<&0
dd iflag=fullblock bs=16 count=1 of="$header_file" status=none <&3 2>/dev/null || true
# An empty connection is not a new stream and must not replace a player.
[[ -s $header_file ]] || exit 0
if cmp -s "$header_file" <(printf 'PI_VOICE_CONTROL'); then
  command=
  target_id= expected_boot= extra=
  IFS=' ' read -r -n 128 command target_id expected_boot extra <&3 || true
  [[ -z $extra ]] || exit 0
  [[ -z $expected_boot || $command == stop || $command == renew ]] || exit 0
  if [[ $command == hello && -z $target_id ]]; then
    protocol=4
    [[ -r $script_dir/pi-voice-mpv-watchdog.lua ]] || { printf '{"type":"error","message":"Install all matching Pi Voice client helpers, including pi-voice-mpv-watchdog.lua"}\n'; exit 1; }
    printf '{"type":"protocol","version":4,"native_watchdog":true,"lease_seconds":30}\n' || exit 1
    audio_header=
    IFS= read -r -n 128 audio_header <&3 || exit 1
    [[ $audio_header == 'PI_VOICE_PREPARE 4' ]] || { printf '{"type":"error","message":"Pi Voice requires v4 native watchdog support; upgrade host and all client helpers together"}\n'; exit 1; }
  else
    [[ $target_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || exit 0
    target_socket="$runtime_dir/pi-voice-mpv-$target_id.sock"
    target_state="$playback_dir/$target_id"
    legacy_state="$runtime_dir/pi-voice-session-$target_id"
    if [[ $command == renew ]]; then
      [[ $boot_id != null && $expected_boot == "${boot_id//\"/}" && -f $target_state/bound && -f $target_state/committed ]] || exit 1
      exec 9>"$target_state/lock" || exit 1
      flock -x -w 1 9 || exit 1
      [[ ! -f $target_state/stopped && ! -f $target_state/exited && -S $target_socket ]] || exit 1
      read -r bound_id bound_boot _ <"$target_state/bound" || exit 1
      [[ $bound_id == "$target_id" && $bound_boot == "$expected_boot" ]] || exit 1
      # Private, ephemeral ACK; only the native callback publishes this nonce.
      renew_ack="$target_state/binding.ack"
      rm -f "$renew_ack" || exit 1
      printf '{"command":["script-message","pi-voice-renew","%s","%s","%s"]}\n' "$target_id" "$expected_boot" "$random" |
        socat -T 1 - "UNIX-CONNECT:$target_socket" >/dev/null 2>&1 || exit 1
      # Compare the entire file, not a substring or a newline-stripped value.
      for _ in {1..10}; do
        cmp -s "$renew_ack" <(printf '%s' "$random") && break
        sleep 0.02
      done
      cmp -s "$renew_ack" <(printf '%s' "$random") || exit 1
      rm -f "$renew_ack" || exit 1
      printf '{"type":"renewed","id":"%s","boot_id":%s}\n' "$target_id" "$boot_id"
    elif [[ $command == pause || $command == resume ]] && [[ -S $target_socket ]]; then
      paused=false
      [[ $command == pause ]] && paused=true
      printf '{"command":["set_property","pause",%s]}\n' "$paused" |
        socat -T 1 - "UNIX-CONNECT:$target_socket" >/dev/null 2>&1 || true
    elif [[ $command == stop ]]; then
      [[ -z $expected_boot || $expected_boot == null || $expected_boot =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || exit 0
      if [[ -n $expected_boot && $expected_boot != null && $boot_id != null && $expected_boot != "${boot_id//\"/}" ]]; then
        # The host compares our independently read identity with the original device.
        printf '{"type":"stopped","id":"%s","boot_id":%s,"device_id":%s,"proof":"reboot","expected_boot_id":"%s"}\n' "$target_id" "$boot_id" "$device_id" "$expected_boot"
        exit 0
      fi
      # The same scope lock covers commit/spawn and stop's durable tombstone.
      if [[ -d $target_state && -f $target_state/prepared ]]; then
        exec 9>"$target_state/lock" || exit 1
        flock -x -w 5 9 || exit 1
        (umask 077; touch "$target_state/stopped") && sync "$target_state/stopped" "$target_state" || exit 1
        if [[ $(cat "$target_state/admission-protocol" 2>/dev/null) == v4-start-intent-1 && ! -e $target_state/admission-intent ]]; then
          # Only this protocol guarantees no start before durable intent. Commit
          # proves possible spawn, not admission. The same lock seals future starts.
          # Legacy scopes without this metadata must remain conservatively fenced.
          [[ $boot_id != null && $(cat "$target_state/prepared") == "$boot_id" && $(kernel_boot) == "$boot_id" ]] || exit 1
          (umask 077
            printf '{"id":"%s","boot_id":%s,"proof":"sealed-nonadmission"}\n' "$target_id" "$boot_id" >"$target_state/not-admitted.tmp" &&
              sync "$target_state/not-admitted.tmp" &&
              mv -f "$target_state/not-admitted.tmp" "$target_state/not-admitted" &&
              sync "$target_state"
          ) || exit 1
        fi
        flock -u 9
      else
        for target in "$target_state" "$legacy_state"; do
          [[ -d $target ]] && (umask 077; touch "$target/stopped")
        done
      fi
      if [[ -S $target_socket ]]; then
        printf '{"command":["quit"]}\n' |
          socat -T 1 - "UNIX-CONNECT:$target_socket" >/dev/null 2>&1 || true
      fi
      # A missing socket/PID is not proof of exit. Retain the owner's receipt
      # for retries when a stop ACK (or natural completion) was lost.
      for _ in {1..100}; do
        if [[ ! -f $target_state/exited && -f $target_state/bound ]]; then
          (exec 9>"$target_state/lock" && flock -x -w 1 9 && publish_native_exit "$target_state") || true
        fi
        proof_file="$target_state/exited"
        [[ -f $target_state/not-admitted ]] && proof_file="$target_state/not-admitted"
        if { [[ -f $proof_file ]] && sync "$proof_file" "$target_state"; } || [[ -f $legacy_state/exited ]]; then
          if [[ -f $proof_file ]]; then
            receipt=$(cat "$proof_file")
            printf '{"type":"stopped",%s\n' "${receipt:1}" || true
          else
            printf '{"type":"stopped","id":"%s"}\n' "$target_id" || true
          fi
          break
        fi
        [[ -d $target_state || -d $legacy_state ]] || break
        sleep 0.05
      done
    fi
    exit 0
  fi
fi

# Raw PCM and v2 clients may not start physical output.
[[ $protocol == 4 && $boot_id != null ]] || { printf '{"type":"error","message":"Native playback watchdog requires readable Linux kernel boot identity"}\n'; exit 1; }

# Reserve a durable opaque scope before any player I/O.
(
  umask 077
  durable_parent=$state_home
  while [[ ! -d $durable_parent ]]; do durable_parent=$(dirname "$durable_parent"); done
  mkdir -p "$state_home" || exit 1
  for directory in "$state_home/pi-voice" "$playback_dir"; do
    [[ ! -L $directory ]] || exit 1
    mkdir -p "$directory" && [[ -O $directory ]] && chmod 700 "$directory" || exit 1
  done
  mkdir -m 700 "$state_dir" || exit 1
  printf '%s\n' "$boot_id" >"$state_dir/prepared" || exit 1
  printf 'v4-start-intent-1\n' >"$state_dir/admission-protocol" || exit 1
  sync "$state_dir/prepared" "$state_dir/admission-protocol" || exit 1
  directory=$state_dir
  while :; do
    sync "$directory" || exit 1
    [[ $directory -ef $durable_parent ]] && break
    directory=$(dirname "$directory")
  done
) || exit 1
printf '{"type":"prepared","version":4,"id":"%s","boot_id":%s,"device_id":%s,"boot_fenced":true,"native_watchdog":true,"lease_seconds":30}\n' "$session_id" "$boot_id" "$device_id" || exit 1
commit=
IFS= read -r -n 128 commit <&3 || exit 1
[[ $commit == "PI_VOICE_COMMIT $session_id ${boot_id//\"/}" ]] || exit 1
exec 9>"$state_dir/lock" || exit 1
flock -x -w 5 9 || exit 1
[[ ! -f $state_dir/stopped ]] || exit 1
# Persist possible spawn; only admission-intent below permits audio dispatch.
(umask 077; touch "$state_dir/committed") && sync "$state_dir/committed" "$state_dir" || exit 1

# Starting a new stream atomically requests the prior scope to quit. This is
# best-effort only: host ownership gates admission; the native lease bounds orphans.
for _ in {1..100}; do
  if mkdir "$player_lock" 2>/dev/null; then
    lock_held=true
    printf '%s\n' "${BASHPID:-$$}" >"$player_lock/owner"
    break
  fi
  lock_owner=$(cat "$player_lock/owner" 2>/dev/null || true)
  lock_command=$(tr '\0' ' ' <"/proc/$lock_owner/cmdline" 2>/dev/null || true)
  if [[ -z $lock_owner ]]; then
    sleep 0.05
    [[ -z $(cat "$player_lock/owner" 2>/dev/null || true) ]] && rm -rf "$player_lock" 2>/dev/null || true
  elif [[ ! $lock_owner =~ ^[0-9]+$ ]] || [[ $lock_command != *pi-voice-audio-session* ]]; then
    rm -rf "$player_lock" 2>/dev/null || true
  fi
  sleep 0.01
done
[[ $lock_held == true ]] || exit 1
old_id=
read -r old_id _ <"$active_player_file" 2>/dev/null || true
if [[ $old_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] && [[ -S $runtime_dir/pi-voice-mpv-$old_id.sock ]]; then
  printf '{"command":["quit"]}\n' |
    socat -T 0.1 - "UNIX-CONNECT:$runtime_dir/pi-voice-mpv-$old_id.sock" >/dev/null 2>&1 || true
fi

# ponytail: retain receipts indefinitely; add expiry only with a safe retry horizon.
rm -f "$ipc_socket" "$audio_fifo"
mkfifo "$audio_fifo"

# A known preparation boot must still be observable immediately before spawn.
[[ $boot_id == null || $(kernel_boot) == "$boot_id" ]] || exit 1
pi_voice_player() {
umask 077
PI_VOICE_SCOPE="$session_id" PI_VOICE_BOOT="${boot_id//\"/}" PI_VOICE_BINDING="$state_dir/binding" PI_VOICE_FIFO="$audio_fifo" \
exec mpv --no-config --load-scripts=no --script="$script_dir/pi-voice-mpv-watchdog.lua" --idle=yes \
  --really-quiet --no-video --cache=no \
  --input-ipc-server="$ipc_socket" \
  --demuxer=rawaudio \
  --demuxer-rawaudio-format=floatle \
  --demuxer-rawaudio-rate=24000 \
  --demuxer-rawaudio-channels=mono
}
pi_voice_player 9>&- > /dev/null 2>/dev/null &
mpv_pid=$!
# The idle native player must identify itself before PCM can be opened.
for _ in {1..100}; do
  [[ -f $state_dir/binding && -S $ipc_socket ]] && break
  sleep 0.02
done
[[ -f $state_dir/binding && -S $ipc_socket ]] || { printf '{"type":"error","message":"mpv native watchdog failed to bind before audio; install matching client helpers and an mpv build with Lua support"}\n'; exit 1; }
read -r bound_id bound_boot native_pid bound_ticks bound_uid bound_pidns bound_mntns bound_version bound_timens extra <"$state_dir/binding" || exit 1
[[ -z $extra && $bound_id == "$session_id" && $bound_boot == "${boot_id//\"/}" && $native_pid =~ ^[1-9][0-9]*$ && $bound_ticks =~ ^[0-9]+$ ]] || exit 1
[[ $bound_uid == "$(id -u)" && $bound_pidns == "$(readlink /proc/self/ns/pid)" && $bound_mntns == "$(readlink /proc/self/ns/mnt)" ]] || exit 1
[[ $bound_version == binding-v2 && -n $bound_timens && $(reader_timens) == "$bound_timens" ]] || exit 1
native_stat=$(cat "/proc/$native_pid/stat") || exit 1
native_tail=${native_stat##*) }
read -r -a native_fields <<<"$native_tail"
[[ ${native_fields[19]:-} == "$bound_ticks" && $(kernel_boot) == "$boot_id" ]] || exit 1
chmod 600 "$state_dir/binding" && sync "$state_dir/binding" && mv "$state_dir/binding" "$state_dir/bound" && sync "$state_dir" || exit 1
[[ $native_pid != "$mpv_pid" ]] || native_child=true
printf '%s %s\n' "$session_id" "$native_pid" >"$active_player_file"
rm -rf "$player_lock" 2>/dev/null || true
lock_held=false

# stdin is the TCP audio direction. stdout is deliberately kept free for JSON
# playback-position feedback over the reverse direction of the same socket.
[[ ! -f $state_dir/stopped ]] || exit 1
(umask 077; touch "$state_dir/admission-intent") && sync "$state_dir/admission-intent" "$state_dir" || exit 1
pi_voice_feeder <&3 9>&- >"$audio_fifo" &
feeder_pid=$!
printf '{"command":["script-message","pi-voice-start","%s","%s"]}\n' "$session_id" "${boot_id//\"/}" |
  socat -T 0.1 - "UNIX-CONNECT:$ipc_socket" >/dev/null 2>&1 || exit 1
flock -u 9
exec 9>&-

for _ in {1..50}; do
  [[ -S "$ipc_socket" ]] && break
  sleep 0.02
done
[[ -S "$ipc_socket" ]] || exit 1
[[ ! -f $state_dir/stopped ]] || exit 0
printf '{"type":"session","version":4,"id":"%s","boot_id":%s}\n' "$session_id" "$boot_id" || true

request_id=0
# Identity reads only guide polling; they never authorize signals or receipts.
while :; do
  # An unverifiable reader domain cannot end polling or authorize cleanup.
  if [[ $(reader_timens) != "$bound_timens" ]]; then sleep 0.08; continue; fi
  native_stat=$(cat "/proc/$native_pid/stat" 2>/dev/null) || break
  native_tail=${native_stat##*) }
  read -r -a native_fields <<<"$native_tail"
  [[ ${native_fields[19]:-} == "$bound_ticks" ]] || break
  ((request_id += 1))
  response=$(
    printf '{"command":["get_property","time-pos"],"request_id":%d}\n' "$request_id" |
      socat -T 0.08 - "UNIX-CONNECT:$ipc_socket" 2>/dev/null || true
  )
  position=${response#*\"data\":}
  position=${position%%,*}
  if [[ "$position" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    printf '{"type":"playback","position":%s}\n' "$position" || true
  fi
  sleep 0.08
done

stop_feeder
feeder_status=0
wait "$feeder_pid" 2>/dev/null || feeder_status=$?
feeder_pid=
player_status=0
# The polling loop has ended; do not interrupt reaping/proof publication.
trap '' INT TERM
# A surviving launcher is not the native player we just observed exiting.
[[ $native_child == true ]] || builtin kill -KILL %pi_voice_player 2>/dev/null || true
wait "$mpv_pid" 2>/dev/null || player_status=$?
player_exited=true
trap 'exit 1' INT TERM
if [[ $(cat "$active_player_file" 2>/dev/null || true) == "$session_id ${native_pid:-$mpv_pid}" ]]; then
  rm -f "$active_player_file"
fi
mpv_pid=
publish_exit || exit 1
if [[ $protocol == 4 && $player_status == 0 && $feeder_status == 0 && ! -f $state_dir/stopped && $(cat "$state_dir/binding.complete" 2>/dev/null) == "$session_id" ]]; then
  printf '{"type":"complete","id":"%s","boot_id":%s}\n' "$session_id" "$boot_id" || true
fi
