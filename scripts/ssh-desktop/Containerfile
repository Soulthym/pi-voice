FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssh-client openssh-server nodejs ffmpeg socat pulseaudio pulseaudio-utils pipewire-bin wireplumber dbus procps ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd -m -g voice -s /bin/bash voice && passwd -d voice && mkdir -p /run/sshd /work && chown voice:voice /work
WORKDIR /work
CMD ["sleep", "infinity"]
